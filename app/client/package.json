{
  "name": "dog-shelter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "playwright:install": "playwright install --with-deps chromium",
    "test:e2e": "npm run playwright:install && playwright test",
    "test:e2e:ui": "npm run playwright:install && playwright test --ui",
    "test:e2e:debug": "npm run playwright:install && playwright test --debug",
    "test:e2e:headed": "npm run playwright:install && playwright test --headed",
    "test:e2e:chromium": "npm run playwright:install && playwright test --project=chromium"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.6",
    "esbuild-wasm": "^0.28.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.2.2"
  }
}
